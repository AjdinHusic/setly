{
  "name": "@husic/setly",
  "version": "0.3.0",
  "description": "Guided UI for describing and setting app configuration (JSON appsettings, .env, and more)",
  "type": "module",
  "bin": {
    "setly": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/cli.ts --no-open --port 3847",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AjdinHusic/setly.git"
  },
  "bugs": {
    "url": "https://github.com/AjdinHusic/setly/issues"
  },
  "homepage": "https://github.com/AjdinHusic/setly#readme",
  "keywords": [
    "config",
    "appsettings",
    "dotenv",
    "cli",
    "configuration",
    "describe-config"
  ],
  "author": "Ajdin Husic",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^4.21.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
