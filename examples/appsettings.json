{
  "Host": {
    "Name": "My-App",
    "Port": 5731,
    "PublicUrl": "http://localhost:5174"
  },
  "Database": {
    "Connection": {
      "Server": "localhost",
      "Port": 5432,
      "Name": "setly_demo",
      "User": "app",
      "Ssl": true
    },
    "Pool": {
      "Min": 2,
      "Max": 20,
      "IdleTimeoutSeconds": 60
    }
  },
  "Logging": {
    "Level": "Information",
    "Console": {
      "Enabled": true,
      "IncludeScopes": false
    },
    "File": {
      "Enabled": false,
      "Path": "logs/app.log"
    }
  },
  "Features": {
    "EnableBetaUi": false,
    "MaxUploadMb": 25,
    "AllowedOrigins": ["http://localhost:5173", "https://app.example.local"]
  },
  "Security": {
    "ApiKey": "",
    "Session": {
      "CookieName": "setly.sid",
      "TtlMinutes": 120
    }
  }
}
