{
    "TargetFile": ".env",
    "Parameters": {
        "HOST": {
            "NAME": {
                "InitialValue": "My-App",
                "Type": "string",
                "Description": "Service display name.",
                "Label": "Host name",
                "Required": true
            },
            "PORT": {
                "InitialValue": 8000,
                "Type": "number",
                "Description": "Listen port.",
                "Label": "Host port",
                "Required": true
            }
        },
        "PUBLIC": {
            "URL": {
                "InitialValue": "https://app.example.local",
                "Type": "string",
                "Description": "Public base URL.",
                "Label": "Public URL",
                "Required": false
            }
        },
        "DB": {
            "SERVER": {
                "InitialValue": "localhost",
                "Type": "string",
                "Description": "Database host.",
                "Label": "DB server",
                "Required": true
            },
            "PORT": {
                "InitialValue": 5432,
                "Type": "number",
                "Description": "Database port.",
                "Label": "DB port",
                "Required": true
            },
            "NAME": {
                "InitialValue": "setly_demo",
                "Type": "string",
                "Description": "Database name.",
                "Label": "DB name",
                "Required": true
            },
            "USER": {
                "InitialValue": "app",
                "Type": "string",
                "Description": "Database user.",
                "Label": "DB user",
                "Required": true
            },
            "SSL": {
                "InitialValue": true,
                "Type": "boolean",
                "Description": "Require SSL for DB connections.",
                "Label": "DB SSL",
                "Required": false
            }
        },
        "LOG": {
            "LEVEL": {
                "InitialValue": "Information",
                "Type": "string",
                "Description": "Minimum log level.",
                "Label": "Log level",
                "Required": false
            }
        },
        "FEATURE": {
            "BETA": {
                "UI": {
                    "InitialValue": false,
                    "Type": "boolean",
                    "Description": "Enable beta UI features.",
                    "Label": "Beta UI",
                    "Required": false
                }
            }
        },
        "API": {
            "KEY": {
                "InitialValue": "",
                "Type": "string",
                "Description": "API key — required before deploy.",
                "Label": "API key",
                "Required": true
            }
        }
    },
    "Separator": "_"
}
