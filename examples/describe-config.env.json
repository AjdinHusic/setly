{
    "TargetFile": ".env",
    "Parameters": {
        "HOST_NAME": {
            "InitialValue": "My-App",
            "Type": "string",
            "Description": "Service display name.",
            "Label": "Host name",
            "Required": true
        },
        "HOST_PORT": {
            "InitialValue": 8000,
            "Type": "number",
            "Description": "Listen port.",
            "Label": "Host port",
            "Required": true
        },
        "PUBLIC_URL": {
            "InitialValue": "https://app.example.local",
            "Type": "string",
            "Description": "Public base URL.",
            "Label": "Public URL",
            "Required": false
        },
        "DB_SERVER": {
            "InitialValue": "localhost",
            "Type": "string",
            "Description": "Database host.",
            "Label": "DB server",
            "Required": true
        },
        "DB_PORT": {
            "InitialValue": 5432,
            "Type": "number",
            "Description": "Database port.",
            "Label": "DB port",
            "Required": true
        },
        "DB_NAME": {
            "InitialValue": "setly_demo",
            "Type": "string",
            "Description": "Database name.",
            "Label": "DB name",
            "Required": true
        },
        "DB_USER": {
            "InitialValue": "app",
            "Type": "string",
            "Description": "Database user.",
            "Label": "DB user",
            "Required": true
        },
        "DB_SSL": {
            "InitialValue": true,
            "Type": "boolean",
            "Description": "Require SSL for DB connections.",
            "Label": "DB SSL",
            "Required": false
        },
        "LOG_LEVEL": {
            "InitialValue": "Information",
            "Type": "string",
            "Description": "Minimum log level.",
            "Label": "Log level",
            "Required": false
        },
        "FEATURE_BETA_UI": {
            "InitialValue": false,
            "Type": "boolean",
            "Description": "Enable beta UI features.",
            "Label": "Beta UI",
            "Required": false
        },
        "API_KEY": {
            "InitialValue": "",
            "Type": "string",
            "Description": "API key — required before deploy.",
            "Label": "API key",
            "Required": true
        }
    }
}
